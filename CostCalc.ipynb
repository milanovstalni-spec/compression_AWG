   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "T=300\n",
    "dT=5 # NOTE: dT here is different from \Delta T in the paper. Specifically, 2dT=\Delta T\n",
    "P0i=101325\n",
    "Pewvl=2622\n",
    "Pewvu=4720\n",
    "Pewv=3538\n",
    "V=1\n",
    "\n",
    "h=0.9\n",
    "P0=P0i-Pewv*h\n",
    "nwv=Pewv*h*V/(8.314*T)\n",
    "\n",
    "#Create a set 'compression' representing different values for peak compression.\n",
    "c=1-h+0.1\n",
    "compression=[]\n",
    "while c<1:\n",
    "    compression.append(c)\n",
    "    c=c+0.01\n",
    "\n",
    "comp=[]\n",
    "nw=[]\n",
    "mw=[]\n",
    "w=[]\n",
    "eff=[]\n",
    "for c in compression:\n",
    "# Assiming 'c' from 'compression' represents peak compression, calculate the number of moles of liquid water created when running volume 'V' of air through one cycle\n",
    "    nw.append(max(nwv*(1-(1-c)/h),0))\n",
    "# Assiming 'c' from 'compression' represents peak compression, calculate the work needed to run  volume 'V' of air through one cycle\n",
    "    w.append(Pewv*h*V*(1+np.log(Pewvu/(h*Pewv)))-Pewvu*V*(1-c)-Pewvl*V*(1-c)*np.log(1/(1-c))+P0*V*np.log(1/(1-c))*(2*dT/T+0.01))\n",
    "    \n",
    "for i in range(len(w)):\n",
    "    # Convert moles to liters\n",
    "    mw.append(nw[i]*0.018)\n",
    "    # Convert compression to percentages\n",
    "    comp.append(compression[i]*100)\n",
    "    if nw[i]==0:\n",
    "        eff.append(0)\n",
    "    else:\n",
    "        eff.append(w[i]/mw[i]/1000)\n",
    "\n",
    "\n",
    "        \n",
    "\n",
    "        \n",
    "        \n",
    "        \n",
    "        \n",
    "comp.append(0)\n",
    "eff.append(0)\n",
    "mw.append(0)\n",
    "\n",
    "# Create figure and first axis\n",
    "fig, ax1 = plt.subplots(figsize=(8, 5))\n",
    "\n",
    "# Plot first set of points\n",
    "ax1.plot(comp[0:-1], mw[0:-1], color='b', linewidth=2)\n",
    "ax1.scatter(comp[len(mw)-1], mw[len(mw)-1], color='b', linewidth=2)\n",
    "ax1.set_xlabel(\"compression (%)\", fontsize=16)\n",
    "ax1.set_ylabel(\"water generated (L)\", color='b', fontsize=16)\n",
    "\n",
    "# Create second y-axis\n",
    "ax2 = ax1.twinx()\n",
    "ax2.plot(comp[0:-1], eff[0:-1], color='r', linewidth=2)\n",
    "ax2.plot(comp[len(mw)-1], eff[len(mw)-1], color='r', linewidth=2)\n",
    "ax2.set_ylabel(\"cost (kJ/L)\", color='r', fontsize=16)\n",
    "\n",
    "print(min(eff[:-1]))\n",
    "\n",
    "# Title\n",
    "plt.title(\"Humidity: \" + str(h), fontsize=16)\n",
    "\n",
    "# Show plot\n",
    "plt.show()"
   ]
